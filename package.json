{
  "name": "college-event-fund-dapp",
  "version": "1.0.0",
  "description": "Transparent College Event Fund Management DApp (Ethereum, Hardhat, React)",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
