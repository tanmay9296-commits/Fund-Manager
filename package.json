  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "hardhat": "^3.19.0",
    "solc": "^0.8.28"
  },
  "type": "module"
}
